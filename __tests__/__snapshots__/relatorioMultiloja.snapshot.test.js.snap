exports[`relatório de várias lojas 2 lojas: total do grupo, uma linha por loja, links por loja e do grupo: pagina 1`] = `
"<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<title>Sua semana nas suas 2 lojas</title>
<style>
  :root { color-scheme: light dark; }
  body { margin: 0; }
  @media (prefers-color-scheme: dark) {
    .a-bg { background: #0c0a16 !important; }
    .a-card { background: #15122a !important; border-color: #2b2650 !important; }
    .a-ink { color: #ece9ff !important; }
    .a-ink2 { color: #b3add8 !important; }
    .a-line { border-color: #2b2650 !important; }
    .a-soft { background: #1d1938 !important; border-color: #2b2650 !important; }
    .a-btn { background: #a78bfa !important; color: #14102b !important; }
    .a-link { color: #a78bfa !important; }
    .a-bar { background: #3b3270 !important; }
    .a-lkbg { background: #1d1938 !important; border-color: #4c3f8f !important; }
    .a-lk { color: #c4b5fd !important; }
  }
</style>
</head>
<body class="a-bg" style="margin:0;padding:0;background:#f4f1fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-bg" style="background:#f4f1fb;">
  <tr><td align="center" style="padding:24px 12px 48px;">
    <table role="presentation" width="680" cellpadding="0" cellspacing="0" class="a-card" style="max-width:680px;width:100%;background:#ffffff;border:1px solid #e4def5;border-radius:14px;">
      <tr><td class="a-line" style="padding:14px 22px;border-bottom:1px solid #e4def5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <img src="https://app.getaura.com.br/email/aura-logo-v1.png" width="28" height="28" alt="Aura" style="display:inline-block;width:28px;height:28px;vertical-align:middle;border:0;margin-right:9px;">
        <span class="a-ink" style="font-weight:700;font-size:16px;letter-spacing:-.2px;color:#1b1736;vertical-align:middle;">Aura.</span>
        <span class="a-ink2" style="font-size:12px;color:#51497f;vertical-align:middle;margin-left:6px;">Relatório da semana</span>
      </td></tr>
      <tr><td style="padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <h1 class="a-ink" style="margin:0 0 4px;font-size:26px;line-height:1.2;font-weight:700;color:#1b1736;">Sua semana nas suas 2 lojas</h1>
        <p class="a-ink2" style="margin:0 0 18px;color:#51497f;font-size:14px;">De 19/10 a 24/10 · Matriz e Centro.</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-soft" style="background:#f1ecfd;border:1px solid #e4def5;border-radius:12px;margin:0 0 14px;"><tr><td style="padding:14px 16px;"><p class="a-ink2" style="margin:0 0 8px;color:#51497f;font-size:11px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;">Vendas da semana</p><p class="a-ink" style="margin:0 0 4px;color:#1b1736;font-size:26px;line-height:1.2;font-weight:700;">R$&nbsp;2.800,85 <span style="color:#15803d;font-weight:700;white-space:nowrap;">&#9650; 38%</span></p><p class="a-ink2" style="margin:0 0 8px;color:#51497f;font-size:12px;line-height:1.5;">Total do grupo, em 17 vendas, ticket médio R$&nbsp;164,76. Comparado com a semana anterior das mesmas 2 lojas (R$&nbsp;2.024,85).</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-card a-line" style="margin:0 0 10px;background:#ffffff;border:1px solid #e4def5;border-radius:10px;border-collapse:separate;table-layout:fixed;"><tr><td width="46%" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;">Loja</td><td width="30%" align="right" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;text-align:right;">Faturamento</td><td width="24%" align="right" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;text-align:right;">Vs. anterior</td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">Matriz <span class="a-ink2" style="color:#51497f;font-size:12px;">· 11 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width=