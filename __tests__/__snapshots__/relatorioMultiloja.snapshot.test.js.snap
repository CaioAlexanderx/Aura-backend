exports[`relatório de várias lojas 3 lojas com uma nova: "começou em", fora da comparação, um passo; o assunto conta a loja: email 1`] = `
"<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Sua semana nas suas 3 lojas: R$ 2.800,85 (+38%)</title>
<style>
  :root { color-scheme: light dark; supported-color-schemes: light dark; }
  @media (prefers-color-scheme: dark) {
    .a-bg { background: #0c0a16 !important; }
    .a-card { background: #15122a !important; border-color: #2b2650 !important; }
    .a-ink { color: #ece9ff !important; }
    .a-ink2 { color: #b3add8 !important; }
    .a-line { border-color: #2b2650 !important; }
    .a-soft { background: #1d1938 !important; border-color: #2b2650 !important; }
    .a-btn { background: #a78bfa !important; color: #14102b !important; }
    .a-wa { color: #6ee7b7 !important; border-color: #6ee7b7 !important; }
    .a-link { color: #a78bfa !important; }
    .a-sig { filter: invert(1) brightness(1.6); }
    .a-lkbg { background: #1d1938 !important; border-color: #4c3f8f !important; }
    .a-lk { color: #c4b5fd !important; }
  }
</style>
</head>
<body class="a-bg" style="margin:0;padding:0;background:#f4f1fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">Total do grupo e cada loja: vendas, mais vendidos, estoque e contas, equipe e margem, clientes, loja online e crediário da semana</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-bg" style="background:#f4f1fb;">
  <tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="560" cellpadding="0" cellspacing="0" class="a-card" style="max-width:560px;width:100%;background:#ffffff;border:1px solid #e4def5;border-radius:14px;">
      <tr><td class="a-line" style="padding:14px 22px;border-bottom:1px solid #e4def5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><img src="https://app.getaura.com.br/email/aura-logo-v1.png" width="28" height="28" alt="Aura" style="display:inline-block;width:28px;height:28px;vertical-align:middle;border:0;margin-right:9px;"><span class="a-ink" style="font-weight:700;font-size:16px;letter-spacing:-.2px;color:#1b1736;vertical-align:middle;">Aura.</span></td></tr>
      <tr><td style="padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<h1 class="a-ink" style="margin:0 0 4px;font-size:24px;line-height:1.2;font-weight:700;color:#1b1736;">Sua semana nas suas 3 lojas</h1>
