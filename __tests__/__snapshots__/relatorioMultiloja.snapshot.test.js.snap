exports[`relatório de várias lojas 5 lojas: as 3 maiores e "outras N lojas" no e-mail; a página mostra todas: pagina 1`] = `
"<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<title>Sua semana nas suas 5 lojas</title>
<style>
  :root { color-scheme: light dark; }
  body { margin: 0; }
  @media (prefers-color-scheme: dark) {
    .a-bg { background: #0c0a16 !important; }
    .a-card { background: #15122a !important; border-color: #2b2650 !important; }
    .a-ink { color: #ece9ff !important; }
    .a-ink2 { color: #b3add8 !important; }
    .a-line { border-color: #2b2650 !important; }
    .a-soft { background: #1d1938 !important; border-color: #2b2650 !important; }
    .a-btn { background: #a78bfa !important; color: #14102b !important; }
    .a-link { color: #a78bfa !important; }
    .a-bar { background: #3b3270 !important; }
    .a-lkbg { background: #1d1938 !important; border-color: #4c3f8f !important; }
    .a-lk { color: #c4b5fd !important; }
  }
</style>
</head>
<body class="a-bg" style="margin:0;padding:0;background:#f4f1fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-bg" style="background:#f4f1fb;">
  <tr><td align="center" style="padding:24px 12px 48px;">
    <table role="presentation" width="680" cellpadding="0" cellspacing="0" class="a-card" style="max-width:680px;width:100%;background:#ffffff;border:1px solid #e4def5;border-radius:14px;">
      <tr><td class="a-line" style="padding:14px 22px;border-bottom:1px solid #e4def5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <img src="https://app.getaura.com.br/email/aura-logo-v1.png" width="28" height="28" alt="Aura" style="display:inline-block;width:28px;height:28px;vertical-align:middle;border:0;margin-right:9px;">
        <span class="a-ink" style="font-weight:700;font-size:16px;letter-spacing:-.2px;color:#1b1736;vertical-align:middle;">Aura.</span>
        <span class="a-ink2" style="font-size:12px;color:#51497f;vertical-align:middle;margin-left:6px;">Relatório da semana</span>
      </td></tr>
      <tr><td style="padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <h1 class="a-ink" style="margin:0 0 4px;font-size:26px;line-height:1.2;font-weight:700;color:#1b1736;">Sua semana nas suas 5 lojas</h1>
        <p class="a-ink2" style="margin:0 0 18px;color:#51497f;font-size:14px;">De 19/10 a 24/10.</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-soft" style="background:#f1ecfd;border:1px solid #e4def5;border-radius:12px;margin:0 0 14px;"><tr><td style="padding:14px 16px;"><p class="a-ink2" style="margin:0 0 8px;color:#51497f;font-size:11px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;">Vendas da semana</p><p class="a-ink" style="margin:0 0 4px;color:#1b1736;font-size:26px;line-height:1.2;font-weight:700;">R$&nbsp;4.100,85 <span style="color:#15803d;font-weight:700;white-space:nowrap;">&#9650; 20%</span></p><p class="a-ink2" style="margin:0 0 8px;color:#51497f;font-size:12px;line-height:1.5;">Total do grupo, em 26 vendas, ticket médio R$&nbsp;157,73. Comparado com a semana anterior das 4 lojas que venderam nas duas semanas (R$&nbsp;3.244,85).</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="a-card a-line" style="margin:0 0 10px;background:#ffffff;border:1px solid #e4def5;border-radius:10px;border-collapse:separate;table-layout:fixed;"><tr><td width="46%" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;">Loja</td><td width="30%" align="right" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;text-align:right;">Faturamento</td><td width="24%" align="right" class="a-soft a-ink2" style="padding:8px 10px;background:#f1ecfd;color:#51497f;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;text-align:right;">Vs. anterior</td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">Matriz <span class="a-ink2" style="color:#51497f;font-size:12px;">· 11 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width="45%" style="height:6px;line-height:6px;font-size:1px;background:#c9b8f5;border-radius:3px;">&nbsp;</td><td width="55%" style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr></table></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><strong>R$&nbsp;1.830,40</strong><br><span class="a-ink2" style="color:#51497f;font-size:11.5px;">45% do grupo</span></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><span style="color:#15803d;font-weight:700;white-space:nowrap;">&#9650; 52%</span></td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">Centro <span class="a-ink2" style="color:#51497f;font-size:12px;">· 6 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width="24%" style="height:6px;line-height:6px;font-size:1px;background:#c9b8f5;border-radius:3px;">&nbsp;</td><td width="76%" style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr></table></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><strong>R$&nbsp;970,45</strong><br><span class="a-ink2" style="color:#51497f;font-size:11.5px;">24% do grupo</span></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><span style="color:#15803d;font-weight:700;white-space:nowrap;">&#9650; 18%</span></td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">Ateliê Norte <span class="a-ink2" style="color:#51497f;font-size:12px;">· 4 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width="16%" style="height:6px;line-height:6px;font-size:1px;background:#c9b8f5;border-radius:3px;">&nbsp;</td><td width="84%" style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr></table></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><strong>R$&nbsp;640,00</strong><br><span class="a-ink2" style="color:#51497f;font-size:11.5px;">16% do grupo</span></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><span style="color:#b91c1c;font-weight:700;white-space:nowrap;">&#9660; 9%</span></td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">Shopping Leste <span class="a-ink2" style="color:#51497f;font-size:12px;">· 3 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width="11%" style="height:6px;line-height:6px;font-size:1px;background:#c9b8f5;border-radius:3px;">&nbsp;</td><td width="89%" style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr></table></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><strong>R$&nbsp;450,00</strong><br><span class="a-ink2" style="color:#51497f;font-size:11.5px;">11% do grupo</span></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><span style="color:#b91c1c;font-weight:700;white-space:nowrap;">&#9660; 14%</span></td></tr><tr><td valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;">JOSE EXEMPLO PEREIRA <span class="a-ink2" style="color:#51497f;font-size:12px;">· 2 vendas</span><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 0;"><tr><td width="5%" style="height:6px;line-height:6px;font-size:1px;background:#c9b8f5;border-radius:3px;">&nbsp;</td><td width="95%" style="height:6px;line-height:6px;font-size:1px;">&nbsp;</td></tr></table></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;"><strong>R$&nbsp;210,00</strong><br><span class="a-ink2" style="color:#51497f;font-size:11.5px;">5% do grupo</span></td><td align="right" valign="top" class="a-line a-ink" style="padding:9px 10px;border-top:1px solid #e4def5;color:#1b1736;font-size:13px;line-height:1.45;text-align:right;">—<br><span class="a-ink2" style="color:#51497f;font-size:11px;">sem venda na semana passada</span></td></tr></table><p class="a-ink" style="margin:0 0 8px;color:#1b1736;font-size:13.5px;line-height:1.55;">Sexta foi o melhor dia do grupo: R$&nbsp;1.230,26, 30% da semana.</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;table-layout:fixed;"><tr><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:21px;line-height:21px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:26px;line-height:26px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:30px;line-height:30px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:26px;line-height:26px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div style="height:64px;line-height:64px;font-size:1px;background:#6d28d9;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="16%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:47px;line-height:47px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td></tr><tr><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">seg</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">ter</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">qua</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">qui</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">sex</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">sáb</td></tr></table><p class="a-ink2" style="margin:0 0 8px;color:#51497f;font-size:11px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;">Últimas 4 semanas, todas as lojas</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;table-layout:fixed;"><tr><td width="25%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:46px;line-height:46px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="25%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:48px;line-height:48px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="25%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div class="a-card a-bar" style="height:51px;line-height:51px;font-size:1px;background:#e4def5;border-radius:4px 4px 0 0;">&nbsp;</div></td><td width="25%" valign="bottom" align="center" style="padding:0 3px;height:70px;"><div style="height:64px;line-height:64px;font-size:1px;background:#6d28d9;border-radius:4px 4px 0 0;">&nbsp;</div></td></tr><tr><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">há 3</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">há 2</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">anterior</td><td align="center" class="a-ink2" style="padding:4px 2px 0;font-size:10.5px;color:#51497f;">esta</td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;"><tr><td class="a-ink2 a-line" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#51497f;font-size:13px;">28/09 a 03/10</td><td class="a-ink a-line" align="right" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#1b1736;font-size:13px;font-weight:700;text-align:right;white-space:nowrap;">R$&nbsp;2.920,37</td></tr><tr><td class="a-ink2 a-line" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#51497f;font-size:13px;">05/10 a 10/10</td><td class="a-ink a-line" align="right" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#1b1736;font-size:13px;font-weight:700;text-align:right;white-space:nowrap;">R$&nbsp;3.082,61</td></tr><tr><td class="a-ink2 a-line" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#51497f;font-size:13px;">12/10 a 17/10</td><td class="a-ink a-line" align="right" style="padding:6px 0;border-bottom:1px solid #e4def5;color:#1b1736;font-size:13px;font-weight:700;