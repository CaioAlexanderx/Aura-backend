      "sql": "INSERT INTO product_suppliers (company_id, product_id, supplier_id, cost, is_main) SELECT p.company_id, p.id, $3, $4, ($5::boolean OR NOT EXISTS (SELECT 1 FROM product_suppliers x WHERE x.product_id = p.id AND x.is_main)) FROM products p WHERE p.id = ANY($1::uuid[]) AND (p.company_id = $2 OR (p.is_group_shared = true AND p.company_id IN ( SELECT id FROM companies WHERE COALESCE(NULLIF(billing_owner_company_id, id), id) = ( SELECT COALESCE(NULLIF(billing_owner_company_id, id), id) FROM companies WHERE id = $2 ) ))) ON CONFLICT (product_id, supplier_id) DO UPDATE SET cost = COALESCE(EXCLUDED.cost, product_suppliers.cost), is_main = product_suppliers.is_main OR EXCLUDED.is_main, updated_at = NOW()",
    },
  ],
  "status": 200,
}
`;

