# ============================================================
# AURA. — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite .env no GitHub
# ============================================================

# ── Banco de dados (Supabase) ────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Autenticação ─────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere-uma-string-aleatoria-forte-aqui
JWT_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://app.getaura.com.br

# ── Sentry (INF-03) ──────────────────────────────────────────
SENTRY_DSN=https://[KEY]@o[ORG].ingest.sentry.io/[PROJECT_ID]
GIT_SHA=

# ── CORE-04: Categorização Automática via IA ──────────────────────
# Opcional: sem a chave, o sistema usa categoria 'outros' como fallback
ANTHROPIC_API_KEY=sk-ant-...

# ── Health check ─────────────────────────────────────────────
HEALTH_SECRET=

# ── Integrações (preencher após CNPJ aprovado) ───────────────
NFEIO_API_KEY=
ASAAS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Storage (Cloudflare R2) ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-nfe-xmls
