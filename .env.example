# ============================================================
# AURA. — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite .env no GitHub
# ============================================================

# ── Banco de dados (Supabase) ────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Autenticação ─────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere-uma-string-aleatoria-forte-aqui
JWT_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://app.getaura.com.br

# ── Sentry (INF-03) ──────────────────────────────────────────
SENTRY_DSN=https://[KEY]@o[ORG].ingest.sentry.io/[PROJECT_ID]
GIT_SHA=

# ── CORE-04: Categorização Automática via IA ──────────────────────
# Opcional: sem a chave, o sistema usa categoria 'outros' como fallback
ANTHROPIC_API_KEY=sk-ant-...

# ── Health check ─────────────────────────────────────────────
HEALTH_SECRET=

# ── Integrações (preencher após CNPJ aprovado) ───────────────
NFEIO_API_KEY=
ASAAS_API_KEY=
# Recebe na Aura (RA-05): subconta Asaas por empresa. Desligada = rotas 404 e
# nenhuma chamada à Asaas. A chave da subconta é cifrada com DOJO_BAAS_ENC_KEY.
RECEBE_NA_AURA_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Obrigatórias em produção (INC-2026-10-21-03, tq-101) ─────
# Sem fallback no código: se faltarem, a função recusa (não usa valor fixo).
# NFS-e: chave AES-256-GCM das credenciais do provedor (64 chars hex).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AURA_ENCRYPTION_KEY=
# Webhook do Instagram (Meta): sem IG_VERIFY_TOKEN o GET responde 403;
# sem IG_APP_SECRET o POST responde 401.
IG_VERIFY_TOKEN=
IG_APP_SECRET=
# Webhook do WhatsApp (Meta): mesmas regras.
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# ── Storage (Cloudflare R2) ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aura-nfe-xmls

# ── NFC-e: Responsável Técnico (infRespTec, NT 2018.005) ─────
# Dados da AURA (desenvolvedora do emissor), não da lojista. Só entram no
# XML em UF que pede o grupo (hoje MG) e só com as 4 preenchidas e válidas.
AURA_RESP_TEC_CNPJ=
AURA_RESP_TEC_CONTATO=
AURA_RESP_TEC_EMAIL=
AURA_RESP_TEC_FONE=

# ── NFS-e automática (migration 438) ─────────────────────────
# Liga geral da emissão automática da NFS-e na venda com serviço, na OS
# entregue e no recebimento do crediário (services/nfseAutomatica.js).
# Desligada (padrão) = nada muda: os gatilhos não fazem nem uma consulta.
# Ligada, só emite para a empresa com nfse_config.emissao_automatica=true
# (PUT /companies/:id/nfse/automatica/config) e emissor nacional apto —
# que por sua vez depende de NFSE_NACIONAL_ENABLED.
NFSE_AUTOMATICA_ENABLED=false

# ── Equipe Aura (users.is_staff) ─────────────────────────────
# E-mails da equipe, separados por vírgula. Conta da lista ganha is_staff
# depois de confirmar o e-mail (na confirmação ou no login seguinte).
# Vazia = ninguém é promovido; quem já é is_staff no banco segue como está.
# O domínio do e-mail sozinho nunca dá equipe (src/utils/equipeAura.js).
AURA_STAFF_EMAILS=
