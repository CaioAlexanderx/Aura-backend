{
  "name": "aura-backend",
  "version": "1.0.0",
  "description": "Aura. — Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "npx jest --forceExit --detectOpenHandles --runInBand",
    "test:watch": "npx jest --watch --runInBand",
    "test:coverage": "npx jest --coverage --forceExit --runInBand",
    "test:uat": "npx jest --forceExit --detectOpenHandles --testPathPattern=__tests__/uat",
    "test:integration": "npx jest --forceExit --detectOpenHandles --testPathPattern=tests/integration"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "@sentry/node": "^7.114.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterSetup": [],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
