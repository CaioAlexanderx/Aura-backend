{
  "name": "aura-backend",
  "version": "1.0.0",
  "description": "Aura. — Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:baseline": "node scripts/migrate.js baseline",
    "dev": "nodemon src/index.js",
    "test": "node node_modules/jest/bin/jest.js --forceExit --detectOpenHandles --runInBand",
    "test:watch": "node node_modules/jest/bin/jest.js --watch --runInBand",
    "test:coverage": "node node_modules/jest/bin/jest.js --coverage --forceExit --runInBand",
    "test:uat": "node node_modules/jest/bin/jest.js --forceExit --detectOpenHandles --testPathPattern=__tests__/uat",
    "test:integration": "node node_modules/jest/bin/jest.js --forceExit --detectOpenHandles --testPathPattern=tests/integration"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@sentry/node": "^7.114.0",
    "@xmldom/xmldom": "^0.9.10",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fast-xml-parser": "^4.4.1",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
